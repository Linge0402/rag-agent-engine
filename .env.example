# rag-agent-engine 配置模板
# 复制为 .env 后按需修改；.env 已 gitignore，不会进仓库。
# 全部默认值指向本机开发；用服务器开发时改成服务器地址即可，代码零改动。

# ---- 向量库 ----
RAE_QDRANT_URL=http://localhost:6333

# ---- Embedding（OpenAI 兼容端点；服务器部署 bge-m3 时改为服务器地址）----
RAE_EMBEDDING_BASE_URL=http://localhost:11434/v1
RAE_EMBEDDING_MODEL=bge-m3
RAE_EMBEDDING_API_KEY=EMPTY

# ---- LLM（OpenAI 兼容端点；开发期任意端点，W6 部署期指向 vLLM）----
RAE_LLM_BASE_URL=http://localhost:11434/v1
RAE_LLM_MODEL=qwen2.5:7b
RAE_LLM_API_KEY=EMPTY

# ---- 检索默认值 ----
RAE_RETRIEVE_TOP_K=20
RAE_RERANK_TOP_K=6

# ---- 解析安全限制 ----
RAE_MAX_ZIP_ENTRIES=1000
RAE_MAX_UNCOMPRESSED_MB=200
RAE_MAX_IMAGES_PER_DOC=500
RAE_OCR_MAX_PIXELS=40000000
